{
  "name": "amulator",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "toolchain:check": "node scripts/checkToolchain.mjs",
    "guest:build": "node scripts/buildBaremetal.mjs",
    "disasm:fixtures": "node scripts/buildDisasmFixtures.mjs",
    "riscv-tests:build": "node scripts/buildRiscvTests.mjs",
    "build:plugin": "node packages/mcp/scripts/buildPlugin.mjs",
    "smoke:plugin": "pnpm --filter @amulator/mcp exec node --import tsx scripts/smokePlugin.mjs",
    "e2e": "node packages/mcp/scripts/e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0 || ^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "eslint": "^9.39.0 || ^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
